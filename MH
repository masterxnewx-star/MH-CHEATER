<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MH X CHEATS | Key Auth Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        :root {
            --bg-color: #08080a;
            --panel-bg: #111116;
            --accent-red: #ff1e1e;
            --accent-glow: rgba(255, 30, 30, 0.3);
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --border-color: #22222d;
            --success: #22c55e;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-image: radial-gradient(circle at center, #150a0a 0%, #08080a 70%);
        }

        .dashboard {
            width: 100%;
            max-width: 950px;
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 0 40px var(--accent-glow);
            overflow: hidden;
            display: grid;
            grid-template-columns: 260px 1fr;
        }

        @media (max-width: 768px) {
            .dashboard {
                grid-template-columns: 1fr;
            }
        }

        /* Sidebar Styling */
        .sidebar {
            background: #0d0d12;
            border-left: 1px solid var(--border-color);
            padding: 25px 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 35px;
        }

        .logo-dot {
            width: 12px;
            height: 12px;
            background: var(--accent-red);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent-red);
        }

        .logo-text h2 {
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            color: white;
        }

        .logo-text span {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .nav-item {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 12px 15px;
            border-radius: 8px;
            cursor: pointer;
            text-align: right;
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s;
        }

        .nav-item:hover, .nav-item.active {
            background: rgba(255, 30, 30, 0.1);
            color: var(--accent-red);
            border-right: 3px solid var(--accent-red);
        }

        /* Main Content Area */
        .content-area {
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 900;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title i {
            color: var(--accent-red);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
        }

        .stat-card {
            background: #0d0d12;
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }

        .stat-card h4 {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .stat-card span {
            font-size: 1.3rem;
            font-weight: 900;
            color: white;
        }

        .form-panel {
            background: #0d0d12;
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input-group label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .input-control, select {
            width: 100%;
            padding: 12px 15px;
            background: #15151c;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .input-control:focus, select:focus {
            border-color: var(--accent-red);
        }

        .btn-action {
            background: var(--accent-red);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 15px var(--accent-glow);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 30, 30, 0.5);
        }

        .output-box {
            background: #08080a;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
            min-height: 120px;
            max-height: 180px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 0.9rem;
            color: #38bdf8;
            word-break: break-all;
        }

        .output-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-copy {
            background: var(--border-color);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: background 0.2s;
        }

        .btn-copy:hover {
            background: var(--success);
        }

    </style>
</head>
<body>

    <div class="dashboard">
        <!-- Sidebar Navigation -->
        <div class="sidebar">
            <div class="top-nav">
                <div class="logo-area">
                    <div class="logo-dot"></div>
                    <div class="logo-text">
                        <h2>MH X CHEATS</h2>
                        <span>Auth Control System</span>
                    </div>
                </div>
                <div class="nav-menu">
                    <button class="nav-item active"><i class="fa-solid fa-key"></i> توليد المفاتيح</button>
                    <button class="nav-item" onclick="alert('قسم إدارة المفاتيح قيد التطوير')"><i class="fa-solid fa-database"></i> المفاتيح الفعالة</button>
                    <button class="nav-item" onclick="alert('الإحصائيات مرتبطة بالنظام السحابي')"><i class="fa-solid fa-chart-line"></i> إحصائيات الاستخدام</button>
                </div>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted); text-align: center;">
                Status: <span style="color: var(--success);">Online & Secure</span>
            </div>
        </div>

        <!-- Main Panel -->
        <div class="content-area">
            <div class="section-title">
                <i class="fa-solid fa-wand-magic-sparkles"></i> توليد مفاتيح السكربت (Script Keys)
            </div>

            <!-- Quick Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <h4>المدة المتاحة</h4>
                    <span>1يوم - دائم</span>
                </div>
                <div class="stat-card">
                    <h4>الحماية</h4>
                    <span>100% Anti-Bypass</span>
                </div>
                <div class="stat-card">
                    <h4>النوع</h4>
                    <span>HWID Locked</span>
                </div>
            </div>

            <!-- Generator Controls -->
            <div class="form-panel">
                <div class="input-group">
                    <label>مدة صلاحية المفتاح (Duration):</label>
                    <select id="keyDuration" class="input-control">
                        <option value="3Days">3 أيام (3 Days)</option>
                        <option value="7Days" selected>7 أيام (7 Days - أسبوع)</option>
                        <option value="1Month">شهر واحد (1 Month)</option>
                        <option value="Lifetime">دائم (Lifetime / Permanent)</option>
                    </select>
                </div>

                <div class="input-group">
                    <label>عدد المفاتيح المطلوبة:</label>
                    <input type="number" id="keyCount" class="input-control" value="5" min="1" max="50">
                </div>

                <button class="btn-action" onclick="generateScriptKeys()">
                    <i class="fa-solid fa-key"></i> توليد المفاتيح الآن
                </button>
            </div>

            <!-- Results Section -->
            <div class="form-panel" style="gap: 10px;">
                <div class="output-header">
                    <span style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted);">الأكواد الناتجة مع معلومات المدة:</span>
                    <button class="btn-copy" onclick="copyKeys()"><i class="fa-regular fa-copy"></i> نسخ الكل</button>
                </div>
                <div id="keysOutput" class="output-box">اضغط على زر التوليد للحصول على مفاتيح السكربت...</div>
            </div>
        </div>
    </div>

    <script>
        function generateScriptKeys() {
            const duration = document.getElementById('keyDuration').value;
            const count = parseInt(document.getElementById('keyCount').value) || 5;
            
            let durationLabel = "";
            if (duration === "3Days") durationLabel = "[3D]";
            else if (duration === "7Days") durationLabel = "[7D]";
            else if (duration === "1Month") durationLabel = "[1M]";
            else if (duration === "Lifetime") durationLabel = "[LIFE]";

            const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
            let resultText = `--- MH X CHEATS KEYS (${duration}) ---\n`;

            for (let i = 0; i < count; i++) {
                let randomKey = "";
                for (let j = 0; j < 4; j++) {
                    let part = "";
                    for (let k = 0; k < 4; k++) {
                        part += chars.charAt(Math.floor(Math.random() * chars.length));
                    }
                    randomKey += part + (j < 3 ? "-" : "");
                }
                resultText += `MH_${durationLabel}_${randomKey}\n`;
            }

            document.getElementById('keysOutput').innerText = resultText.trim();
        }

        function copyKeys() {
            const text = document.getElementById('keysOutput').innerText;
            if (text.includes("اضغط على زر التوليد") || text.trim() === "") return;

            navigator.clipboard.writeText(text).then(() => {
                alert("تم نسخ المفاتيح بنجاح وجاهزة للاستخدام في سكربتك!");
            });
        }
    </script>
</body>
</html>
